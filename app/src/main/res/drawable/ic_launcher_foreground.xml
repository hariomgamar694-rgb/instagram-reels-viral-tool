<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Reel clapperboard frame rounded -->
    <path
        android:pathData="M35,32 L73,32 A7,7 0 0,1 80,39 L80,71 A7,7 0 0,1 73,78 L35,78 A7,7 0 0,1 28,71 L28,39 A7,7 0 0,1 35,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="32"
                android:endX="80"
                android:endY="78"
                android:type="linear">
                <item android:offset="0.0" android:color="#7C3AED" />
                <item android:offset="0.5" android:color="#A855F7" />
                <item android:offset="1.0" android:color="#EC4899" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner dark viewport for contrast -->
    <path
        android:fillColor="#15102A"
        android:pathData="M38,40 L70,40 A4,4 0 0,1 74,44 L74,68 A4,4 0 0,1 70,72 L38,72 A4,4 0 0,1 34,68 L34,44 A4,4 0 0,1 38,40 Z" />

    <!-- Center Play Arrow glowing cyan & white -->
    <path
        android:pathData="M48,47 L62,56 L48,65 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="47"
                android:endX="62"
                android:endY="65"
                android:type="linear">
                <item android:offset="0.0" android:color="#38BDF8" />
                <item android:offset="1.0" android:color="#FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Upward Viral Growth Arrow / Spark on top right -->
    <path
        android:pathData="M66,32 L75,23 M75,23 L68,23 M75,23 L75,30"
        android:strokeColor="#22D3EE"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Sparkle star -->
    <path
        android:fillColor="#F472B6"
        android:pathData="M32,27 L33,29 L35,30 L33,31 L32,33 L31,31 L29,30 L31,29 Z" />
</vector>
